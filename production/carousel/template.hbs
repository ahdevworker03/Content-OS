<!doctype html>
<html lang="{{LANG}}" dir="{{DIRECTION}}">
  <head>
    <meta charset="UTF-8" />
    <title>{{PAGE_TITLE}}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Caveat:wght@400;600&family=Nunito:wght@400;600&family=Tajawal:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    {{#each SLIDES}}

    <div class="slide-wrapper">
      <div class="slide-num">{{NUMBER}}</div>
      <div class="slide{{#if DIRECTION_RTL}} slide--rtl{{/if}}">
        {{#if TYPE_COVER}}

        <div class="uname">{{USERNAME}}</div>
        <div class="flex-1 d-flex flex-col justify-center gap-32">
          <h1 class="s-title s-title--xl">{{TITLE}}</h1>
          {{#each TEASERS}}
          <div class="s-teaser">{{.}}</div>
          {{/each}}
        </div>

        {{/if}}
        {{#if TYPE_BOX_LIST}}

        {{#if SECTION_TAG}}<div class="section-tag {{SECTION_TAG_CLASS}}">{{SECTION_TAG}}</div>{{/if}}
        {{#if LABEL}}<div class="s-label">{{LABEL}}</div>{{/if}}
        <h2 class="s-title s-title--md{{#if TITLE_MARGIN}} {{TITLE_MARGIN}}{{/if}}">{{TITLE}}</h2>
        {{#each BOX_ITEMS}}
        <div class="box-l m-b-16{{#if ACCENT}} accent-border{{/if}}">
          <p class="s-body s-body--large">{{TEXT}}</p>
        </div>
        {{/each}}

        {{/if}}
        {{#if TYPE_ARROW_LIST}}

        {{#if BIG_NUMBER}}<div class="big-number">{{BIG_NUMBER}}</div>{{/if}}
        <div class="d-flex flex-col h-full">
          {{#if SECTION_TAG}}<div class="section-tag {{SECTION_TAG_CLASS}}">{{SECTION_TAG}}</div>{{/if}}
          <h2 class="s-title s-title--lg m-b-30">{{TITLE}}</h2>
          <div class="arrow-list">
            {{#each ARROW_ITEMS}}
            <div class="arrow-item">
              <div class="ar-text">{{TEXT}}</div>
              <div class="arrow-icon">→</div>
            </div>
            {{/each}}
          </div>
        </div>

        {{/if}}
        {{#if TYPE_GRID_2X2}}

        {{#if BIG_NUMBER}}<div class="big-number">{{BIG_NUMBER}}</div>{{/if}}
        <div class="d-flex flex-col h-full">
          {{#if SECTION_TAG}}<div class="section-tag {{SECTION_TAG_CLASS}}">{{SECTION_TAG}}</div>{{/if}}
          <h2 class="s-title s-title--lg m-b-30">{{TITLE}}</h2>
          <div class="grid4">
            {{#each GRID_ITEMS}}
            <div class="mc">
              <div class="mc-lbl">{{LABEL}}</div>
              <div class="mc-txt">{{TEXT}}</div>
            </div>
            {{/each}}
          </div>
        </div>

        {{/if}}
        {{#if TYPE_BULLET_LIST}}

        {{#if LABEL}}<div class="s-label">{{LABEL}}</div>{{/if}}
        <h2 class="s-title {{TITLE_CLASS}}">{{TITLE}}</h2>
        <div class="box-l">
          <p class="s-body s-body--medium">
            {{#each BULLET_ITEMS}}
            • {{TEXT}}<br />
            {{/each}}
          </p>
        </div>
        {{#if SUMMARY}}
        <div class="box-l2 flex-1 d-flex items-center">
          <p class="s-body s-body--summary">{{SUMMARY}}</p>
        </div>
        {{/if}}

        {{/if}}
        {{#if TYPE_FINAL_CTA}}

        <div class="s-label">{{LABEL}}</div>
        <h2 class="s-title s-title--advice">{{TITLE}}</h2>
        {{#each FINAL_BULLET_ROWS}}
        <div class="bullet-row">
          <div class="dot-sum"></div>
          <p class="s-body s-body--medium">{{TEXT}}</p>
        </div>
        {{/each}}
        {{#if QUOTE}}
        <div class="box-l m-t-30 final-box">
          <p class="s-body s-body--final">{{QUOTE}}</p>
        </div>
        {{/if}}
        {{#if CTA}}
        <div class="box-l2 m-t-30">
          <p class="s-body s-body--final">{{CTA}}</p>
        </div>
        {{/if}}
        <div class="footer-line">
          <div class="footer-name">{{FOOTER_NAME}}</div>
          <div class="footer-handle">{{FOOTER_HANDLE}}</div>
        </div>

        {{/if}}
        <div class="swipe">{{SWIPE}}</div>
      </div>
    </div>

    {{/each}}
  </body>
</html>
